{
  "name": "smart-smile",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": "10.9.7"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "web:dev": "npm run dev --workspace=@smart-smile/web",
    "web:format:check": "npm run format:check --workspace=@smart-smile/web",
    "web:lint": "npm run lint --workspace=@smart-smile/web",
    "web:test": "npm run test --workspace=@smart-smile/web",
    "web:typecheck": "npm run typecheck --workspace=@smart-smile/web",
    "web:e2e": "npm run test:e2e --workspace=@smart-smile/web",
    "web:build": "npm run build --workspace=@smart-smile/web",
    "web:preview": "npm run preview --workspace=@smart-smile/web",
    "web:vision:check": "npm run vision:manifest:check --workspace=@smart-smile/web"
  }
}
