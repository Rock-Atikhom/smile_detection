{
  "name": "@smart-smile/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format:check": "prettier --check --ignore-path .prettierignore . ../../eslint.config.mjs ../../prettier.config.mjs ../../package.json ../../.github/workflows/ci.yml ../../docs ../../README.md",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "vision:vendor": "node scripts/vendor-vision-release.mjs",
    "vision:manifest": "node scripts/generate-vision-manifest.mjs",
    "vision:manifest:check": "node scripts/generate-vision-manifest.mjs --check"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@radix-ui/react-dialog": "1.1.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
